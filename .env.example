# Chave da Sprint 3: usada SOMENTE na geração de respostas Ollama Cloud.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
MODEL_NAME=gpt-oss:120b
MODEL_NAME_2=gpt-oss:20b
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=350
MEMORY_TOKEN_LIMIT=1200
SYSTEM_PROMPT_VERSION=v2

# Sprint 4: embedding Nomic local gratuito (o Python baixa o modelo automaticamente no primeiro uso).
# Nao requer chave Nomic, aplicativo Ollama, nem servidor localhost:11434.
# O modelo de embeddings é nomic-ai/nomic-embed-text-v1.5 (Apache 2.0).
EMBED_MODEL=nomic-embed-text-v1.5
RAG_MODEL=gpt-oss:120b
RAG_PROFILE=iter2
RAG_MAX_DISTANCE=0.65
# Temperatura da Sprint 4: distinta de TEMPERATURE (legado da Sprint 3)
RAG_TEMPERATURE=0
GRADIO_SHARE=false
GRADIO_PORT=7860
